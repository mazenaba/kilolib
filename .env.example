# ========================================================
# Kilo Leb (كيلو لب) Environment Variables Template
# ========================================================

# 1. Admin Authentication Credentials
# Change these values to your secure personal credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
SESSION_SECRET=generate-a-random-32-character-secret-string-here

# 2. Supabase Cloud Database & Storage Credentials
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
